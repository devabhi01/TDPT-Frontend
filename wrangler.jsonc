{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tdpt-frontend",
  "main": "./worker.js",
  "compatibility_date": "2026-11-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
